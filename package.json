{
  "name": "anvil",
  "version": "0.1.0",
  "description": "Task engine and code-search AI agent built from scratch",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "worker": "tsx src/worker.ts",
    "index": "tsx src/search/indexerCli.ts",
    "search": "tsx src/search/searchCli.ts",
    "eval": "tsx src/eval/runner.ts",
    "start:prod": "tsx src/prod.ts",
    "build:web": "npm run --prefix web build",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
