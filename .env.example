# Server Port
PORT=3000

# Environment mode
NODE_ENV=development

# Postgres Database Connection URL
DATABASE_URL=postgresql://anvil_user:anvil_password@localhost:5432/anvil_db

# LLM Configuration ('mock' for tests/free dev, 'gemini' for real API)
LLM_MODE=mock
GEMINI_API_KEY=

# Local repository path for code inspection tools
REPO_PATH=.

